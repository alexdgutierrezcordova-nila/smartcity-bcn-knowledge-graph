@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:  <https://schema.org/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vocab:   <http://example.org/bcn-kg/vocab#> .

# ==============================================================================
# Vocabulario del proyecto (modelo v3, versión final)
#
# Idea central:
#   - Lo que cambia con el tiempo es una schema:Observation: el estado de una
#     estación de Bicing y cada medición de calidad del aire.
#   - Cada observación dice de qué trata con schema:observationAbout
#     (una estación o una celda CAMS).
#   - Toda ubicación usa una sola relación, schema:containedInPlace:
#     Estación → Barrio → Distrito → Barcelona, y Estación → Celda CAMS.
#     La celda es el nodo puente entre movilidad y calidad del aire.
#
# Aquí solo se declaran las clases y atributos propios (vocab:). Las relaciones
# se reutilizan tal cual de schema.org, Dublin Core y SOSA, sin subpropiedades
# propias (evita relaciones duplicadas al razonar en GraphDB).
# La justificación de cada término está en vocabularios_reutilizados.csv.
# ==============================================================================

<http://example.org/bcn-kg/vocab#>
    rdf:type owl:Ontology ;
    rdfs:label "Vocabulario de movilidad y calidad del aire de Barcelona"@es ;
    rdfs:comment "Modelo para integrar la red Bicing (CityBikes), la calidad del aire CAMS (Open-Meteo) y los barrios y distritos de Barcelona (Open Data BCN)."@es ;
    owl:versionInfo "3.0.0" ;
    dcterms:creator "Alex Gutiérrez, David Manotoa" .

# ------------------------------------------------------------------------------
# Clases propias
# ------------------------------------------------------------------------------

vocab:RedBicicletas
    rdf:type rdfs:Class ;
    rdfs:subClassOf schema:Service ;
    rdfs:label "Red de bicicletas compartidas"@es ;
    rdfs:comment "Servicio de bicicletas compartidas de una ciudad. Instancia: Bicing (Barcelona)."@es .

vocab:EstacionBicicleta
    rdf:type rdfs:Class ;
    rdfs:subClassOf schema:CivicStructure ;
    rdfs:label "Estación de bicicletas"@es ;
    rdfs:comment "Punto fijo de la vía pública donde se retiran y devuelven bicicletas. schema.org no tiene una clase específica para estaciones de bicicletas."@es .

vocab:CeldaModelo
    rdf:type rdfs:Class ;
    rdfs:subClassOf schema:Place ;
    rdfs:label "Celda del modelo CAMS"@es ;
    rdfs:comment "Cuadrícula de 0.1° x 0.1° (~11 km) del modelo europeo de calidad del aire CAMS. Sus geo:lat y geo:long son el punto central (centroide) de la cuadrícula. Es el nodo puente entre las estaciones y las mediciones de aire."@es .

vocab:Barrio
    rdf:type rdfs:Class ;
    rdfs:subClassOf schema:AdministrativeArea ;
    rdfs:label "Barrio"@es ;
    rdfs:comment "Barrio oficial de Barcelona (73 en total, Open Data BCN)."@es .

vocab:Distrito
    rdf:type rdfs:Class ;
    rdfs:subClassOf schema:AdministrativeArea ;
    rdfs:label "Distrito"@es ;
    rdfs:comment "Distrito municipal de Barcelona (10 en total, Open Data BCN). Agrupa barrios."@es .

vocab:Contaminante
    rdf:type rdfs:Class ;
    rdfs:subClassOf sosa:ObservableProperty ;
    rdfs:label "Contaminante atmosférico"@es ;
    rdfs:comment "Propiedad que se mide en una observación de calidad del aire (NO2, PM10, PM2.5)."@es .

# ------------------------------------------------------------------------------
# Atributos propios (valores literales)
# Los cuatro conteos y enLinea describen una schema:Observation cuyo
# schema:observationAbout es una estación (el estado de su inventario).
# ------------------------------------------------------------------------------

vocab:bicicletasDisponibles
    rdf:type rdf:Property ;
    rdfs:label "bicicletas disponibles"@es ;
    rdfs:comment "Bicicletas listas para retirar (mecánicas + eléctricas) en el momento de la observación."@es ;
    rdfs:domain schema:Observation ;
    rdfs:range xsd:nonNegativeInteger .

vocab:anclajesLibres
    rdf:type rdf:Property ;
    rdfs:label "anclajes libres"@es ;
    rdfs:comment "Anclajes vacíos donde se puede devolver una bicicleta."@es ;
    rdfs:domain schema:Observation ;
    rdfs:range xsd:nonNegativeInteger .

vocab:bicicletasMecanicas
    rdf:type rdf:Property ;
    rdfs:label "bicicletas mecánicas"@es ;
    rdfs:comment "Bicicletas sin asistencia eléctrica disponibles."@es ;
    rdfs:domain schema:Observation ;
    rdfs:range xsd:nonNegativeInteger .

vocab:bicicletasElectricas
    rdf:type rdf:Property ;
    rdfs:label "bicicletas eléctricas"@es ;
    rdfs:comment "Bicicletas con asistencia eléctrica (ebikes) disponibles."@es ;
    rdfs:domain schema:Observation ;
    rdfs:range xsd:nonNegativeInteger .

vocab:enLinea
    rdf:type rdf:Property ;
    rdfs:label "en línea"@es ;
    rdfs:comment "Indica si la estación estaba conectada al sistema central."@es ;
    rdfs:domain schema:Observation ;
    rdfs:range xsd:boolean .

vocab:distanciaACeldaModeloKm
    rdf:type rdf:Property ;
    rdfs:label "distancia a la celda modelo (km)"@es ;
    rdfs:comment "Distancia Haversine entre la estación y el punto central (geo:lat, geo:long) de su CeldaModelo; mide qué tan representativa es la celda para la estación."@es ;
    rdfs:domain vocab:EstacionBicicleta ;
    rdfs:range xsd:decimal .
