# PC5 · ¿Cuáles son las 10 estaciones con mayor capacidad observada (bicicletas + anclajes libres)?
PREFIX schema: <https://schema.org/>
PREFIX vocab: <http://example.org/bcn-kg/vocab#>
PREFIX data: <http://example.org/bcn-kg/data/>

SELECT ?estacion ?nombre ?capacidad WHERE {
  ?estado a schema:Observation ; schema:observationAbout ?e ;
          vocab:bicicletasDisponibles ?b ; vocab:anclajesLibres ?a .
  ?e schema:name ?nombre . BIND(STRAFTER(STR(?e), STR(data:)) AS ?estacion)
  BIND(?b + ?a AS ?capacidad)
} ORDER BY DESC(?capacidad) ?nombre LIMIT 10
