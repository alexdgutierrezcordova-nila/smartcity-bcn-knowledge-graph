# PC8 · ¿Qué celdas registran PM2.5 horario > 25 µg/m³? Se listan los máximos por celda y si superan.
PREFIX schema: <https://schema.org/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX data: <http://example.org/bcn-kg/data/>

SELECT ?celda (MAX(?v) AS ?pm25_max) (MAX(?v) > 25 AS ?supera) WHERE {
  ?o a schema:Observation ; schema:observationAbout ?c ;
     sosa:observedProperty data:contaminante_PM2_5 ; schema:value ?v .
  BIND(STRAFTER(STR(?c), STR(data:)) AS ?celda)
} GROUP BY ?celda ORDER BY DESC(?pm25_max)
