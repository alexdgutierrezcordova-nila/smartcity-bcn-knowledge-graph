# Enlace de las tres fuentes: estaciones en barrio, en celda CAMS y con datos de aire
# Las estaciones (Fuente 1) se conectan con su barrio (Fuente 3) y su celda CAMS (Fuente 2) porque usan las MISMAS URIs.
#   estaciones_en_barrio      esperado 542 (todas caen dentro del contorno de un barrio)
#   estaciones_en_celda       esperado 542
#   estaciones_con_datos_aire esperado 500 (las 42 de la celda 41.45, 2.25 no tienen punto CAMS consultado)
PREFIX schema: <https://schema.org/>
PREFIX vocab: <http://example.org/bcn-kg/vocab#>

SELECT (COUNT(DISTINCT ?estacion) AS ?estaciones)
       (COUNT(DISTINCT ?enBarrio) AS ?estaciones_en_barrio)
       (COUNT(DISTINCT ?enCelda) AS ?estaciones_en_celda)
       (COUNT(DISTINCT ?conAire) AS ?estaciones_con_datos_aire)
WHERE {
  ?estacion a vocab:EstacionBicicleta .
  OPTIONAL { ?estacion schema:containedInPlace ?barrio . ?barrio a vocab:Barrio . }
  OPTIONAL { ?estacion schema:containedInPlace ?celda . ?celda a vocab:CeldaModelo . }
  BIND(IF(BOUND(?barrio), ?estacion, ?nada) AS ?enBarrio)
  BIND(IF(BOUND(?celda), ?estacion, ?nada) AS ?enCelda)
  BIND(IF(BOUND(?celda) && EXISTS { ?obs schema:observationAbout ?celda }, ?estacion, ?nada) AS ?conAire)
}
