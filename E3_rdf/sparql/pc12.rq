# PC12 · [Integrada] ¿Qué estaciones con 2 o menos anclajes libres están en celdas cuya media diaria de PM10 superó 50 µg/m³ (límite UE)?
# Se usa la media diaria del día de la captura (2026-11-12).
PREFIX schema: <https://schema.org/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX vocab: <http://example.org/bcn-kg/vocab#>
PREFIX data: <http://example.org/bcn-kg/data/>

SELECT ?estacion ?nombre ?anclajes ?celda (ROUND(AVG(?v) * 10) / 10 AS ?pm10_dia) WHERE {
  ?estado schema:observationAbout ?e ; vocab:anclajesLibres ?anclajes .
  FILTER(?anclajes <= 2)
  ?e schema:name ?nombre ; schema:containedInPlace ?c .
  ?o schema:observationAbout ?c ; sosa:observedProperty data:contaminante_PM10 ;
     schema:observationDate ?t ; schema:value ?v .
  FILTER(STRSTARTS(STR(?t), "2026-11-12"))
  BIND(STRAFTER(STR(?e), STR(data:)) AS ?estacion) BIND(STRAFTER(STR(?c), STR(data:)) AS ?celda)
} GROUP BY ?estacion ?nombre ?anclajes ?celda HAVING(AVG(?v) > 50) ORDER BY DESC(?pm10_dia) ?nombre
