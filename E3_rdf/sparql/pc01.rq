# PC1 · ¿Qué estaciones tienen más de 10 bicicletas disponibles en el corte de captura?
PREFIX schema: <https://schema.org/>
PREFIX vocab: <http://example.org/bcn-kg/vocab#>
PREFIX data: <http://example.org/bcn-kg/data/>

SELECT ?estacion ?nombre ?bicicletas WHERE {
  ?estado a schema:Observation ; schema:observationAbout ?e ; vocab:bicicletasDisponibles ?bicicletas .
  ?e schema:name ?nombre . BIND(STRAFTER(STR(?e), STR(data:)) AS ?estacion)
  FILTER(?bicicletas > 10)
} ORDER BY DESC(?bicicletas) ?nombre
