# PC4 · ¿Qué estaciones tienen bicicletas eléctricas disponibles?
PREFIX schema: <https://schema.org/>
PREFIX vocab: <http://example.org/bcn-kg/vocab#>
PREFIX data: <http://example.org/bcn-kg/data/>

SELECT ?estacion ?nombre ?electricas WHERE {
  ?estado a schema:Observation ; schema:observationAbout ?e ; vocab:bicicletasElectricas ?electricas .
  ?e schema:name ?nombre . BIND(STRAFTER(STR(?e), STR(data:)) AS ?estacion)
  FILTER(?electricas > 0)
} ORDER BY DESC(?electricas) ?nombre
